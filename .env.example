# Database
DATABASE_URL=postgresql://openclass:openclass@localhost:54170/openclass

# JWT
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Google OAuth (optional — leave blank to disable)
# Obtain at: https://console.cloud.google.com/auth/clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# SMTP (required for password reset in production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=

# YouTube Data API v3 (required for lesson YouTube URL validation and duration fetch)
# Obtain at: https://console.cloud.google.com/ → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=

# App
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:41700
ALLOW_REGISTRATION=true

# MCP OAuth 2.0
# Optional legacy static bearer token for programmatic clients (Claude Code, curl)
MCP_API_TOKEN=
# OAuth access token lifetime in seconds (default: 3600)
OAUTH_TOKEN_TTL=3600

# UI
NEXT_PUBLIC_API_URL=http://localhost:41701
NEXT_PUBLIC_GOOGLE_OAUTH=true
