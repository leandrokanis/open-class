# Database
DATABASE_URL=postgresql://openclass:openclass@localhost:5432/openclass

# JWT
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# SMTP (required for password reset in production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=

# App
PORT=3001
FRONTEND_URL=http://localhost:3000
ALLOW_REGISTRATION=true
